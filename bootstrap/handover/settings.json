{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["SendMessage", "ListAgents"]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore hooks notify-coordinator",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/spore/.claude/hooks/block-bg-bash.pl",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/home/spore/.claude/hooks/guard-tmux.pl",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/spore/.claude/hooks/load-state-md.pl",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore coordinator token-monitor",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore worker token-monitor",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore fleet replenish-hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/spore hooks watch-inbox",
            "timeout": 604800,
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
